# Copy to .env and fill in. Placeholders only — do not commit real hosts or secrets.

# Twin endpoints (separate RDS instances; provisioned outside this repo)
MYSQL_HOST_V4=v4.example.example
MYSQL_HOST_V7=v7.example.example
MYSQL_PORT=3306
MYSQL_DATABASE=payments_exp
MYSQL_USER=exp_app

# Password: MYSQL_SECRET_ARN is primary in the real experiment.
# Secret payload should be JSON with a "password" field (RDS-managed secrets work).
MYSQL_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:payments-exp/db-XXXXXX
AWS_REGION=us-east-1

# Local / no-AWS override. When set, Secrets Manager is not called.
# MYSQL_PASSWORD=

# Which twin to warmup/measure (also selects UUID type on the measure path)
EXPERIMENT_ARM=v4

# Measure protocol
TARGET_QPS=500
POOL_SIZE=32
WARMUP_MINUTES=25
MEASURE_MINUTES=20
# Client settle after warmup (seconds). Default 120. Use 0 for short local runs.
SETTLE_SECONDS=120

# Hybrid preload. Full experiment ~180–190M bulk + ~10–20M season.
# Both twins MUST use the same counts (shared non-arm key source).
PRELOAD_BULK_ROWS=185000000
PRELOAD_SEASON_ROWS=15000000

# Small-scale path (no AWS, local MySQL):
# PRELOAD_BULK_ROWS=1000
# PRELOAD_SEASON_ROWS=100
# WARMUP_MINUTES=0.05
# MEASURE_MINUTES=0.1
# SETTLE_SECONDS=0
# MYSQL_PASSWORD=dev
# MYSQL_HOST_V4=127.0.0.1
# MYSQL_HOST_V7=127.0.0.1

# Optional preload knobs
# PRELOAD_MODE=batch
# PRELOAD_BATCH_SIZE=1000
# PRELOAD_WORKERS=8
# SEASON_QPS=0
