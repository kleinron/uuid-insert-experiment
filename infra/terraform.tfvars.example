# Copy to terraform.tfvars (gitignored) and replace placeholders.
# Dummy values below are enough for `terraform validate` after `terraform init`.

# Default region is Frankfurt. Override only if you must.
aws_region = "eu-central-1"

# Dedicated VPC is always created (10.42.0.0/16, 2 public subnets, IGW).
# vpc_cidr = "10.42.0.0/16"

# Optional. Defaults to the first AZ in the region (typically eu-central-1a).
# Both RDS twins + the loadgen EC2 are pinned to this AZ. A second public
# subnet is still created in another AZ for the RDS DB subnet group.
# availability_zone = "eu-central-1a"

# SSH to loadgen only from this CIDR (required). Public subnet + associate_public_ip.
allowed_ssh_cidr = "203.0.113.10/32"

# Existing EC2 key pair in this region (optional).
# key_name = "uuid-insert-loadgen"

# Public IP so SSH from allowed_ssh_cidr works on the public subnet (default).
# associate_public_ip = true

# name_prefix = "payments-exp"
